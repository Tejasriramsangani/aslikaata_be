# Google Places API (New) + Geocoding API. Restrict this server-only key to backend egress IPs.
GOOGLE_MAPS_API_KEY=
# Optional service-area search bias (not a search restriction).
GOOGLE_MAPS_BIAS_LAT=
GOOGLE_MAPS_BIAS_LNG=

# SMS authorization key; keep actual credentials only in the private runtime environment.
FAST2SMS_API_KEY=
# WhatsApp authorization key from the Fast2SMS WhatsApp API panel.
# If unset, the existing FAST2SMS_API_KEY remains the compatibility fallback.
FAST2SMS_WA_API_KEY=

# WhatsApp identifiers are different: sender Phone Number ID vs template message IDs.
FAST2SMS_WA_PHONE_NUMBER_ID=
FAST2SMS_WA_OTP_TEMPLATE_ID=42871
FAST2SMS_WA_SIGNUP_OTP_TEMPLATE_ID=42921
FAST2SMS_WA_PICKUP_REQUEST_RECEIVED_TEMPLATE_ID=42922
FAST2SMS_WA_PICKUP_CONFIRMED_TEMPLATE_ID=42923
FAST2SMS_WA_EMPLOYEE_ASSIGNED_TEMPLATE_ID=42924
FAST2SMS_WA_PICKUP_CANCELLED_TEMPLATE_ID=42926
FAST2SMS_WA_PICKUP_COMPLETED_PAYMENT_TEMPLATE_ID=42929
# Explicit approval/configuration required before activating new sends or callback writes.
FAST2SMS_WA_SIGNUP_OTP_ENABLED=false
FAST2SMS_WA_NOTIFICATIONS_ENABLED=false
# UTC ISO date: ignore older outbox events at activation (required when enabled).
FAST2SMS_WA_NOTIFICATIONS_SINCE=
FAST2SMS_WA_WEBHOOK_ENABLED=false
FAST2SMS_WA_WEBHOOK_SECRET=
