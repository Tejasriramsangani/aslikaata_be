PORT=4000
NODE_ENV=development

# MongoDB (Must support replica set for transactions)
MONGODB_URI=mongodb://localhost:27017/aslikaata?replicaSet=rs0

# JWT Secrets
JWT_ACCESS_SECRET=aslikaata_jwt_access_super_secret_key_2026_x98f2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=aslikaata_jwt_refresh_super_secret_key_2026_k31m7
JWT_REFRESH_EXPIRES_IN=30d

# Encryption Key (32-bytes hex for AES-256-GCM)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# SMS Provider (mock | twilio | fast2sms)
SMS_PROVIDER=mock
